# Secret configuration for a Docker Compose deployment of asimapd.
# Copy to secrets.env, fill in, and restrict it:
#
#   cp secrets.env.example secrets.env && chmod 0600 secrets.env
#
# Copied unchanged it sets nothing, and asimapd runs without Sentry.

# The Sentry DSN for this deployment.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
